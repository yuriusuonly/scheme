{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "shell": "/usr/bin/sh",
  "agent": {
    "00-Orchestrator": {
      "description": "Primary agent that orchestrates the entire project.",
      "mode": "primary",
      "permission": {
        "read": "allow",
        "edit": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "bash": "allow",
        "task": "allow",
        "external_directory": "ask",
        "todowrite": "allow",
        "question": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "lsp": "allow",
        "doom_loop": "ask",
        "skill": "allow"
      },
      "prompt": "{file:README.md}"
    }
  },
  "default_agent": "00-Orchestrator",
  "instructions": [
    "README.md"
  ],
  "compaction": {
    "auto": true,
    "prune": true
  },
  "snapshot": true
}
